{erl_opts, [debug_info]}.
%% rabbit_common is used only for headers (#auth_user, the log domain) and, up
%% to RabbitMQ 4.1, the authn behaviour -- all unchanged across 3.11-4.3 -- so
%% this version does not affect runtime compatibility. It is a local-build
%% default; CI compiles against every line from 3.11 to 4.3 (see
%% .github/workflows/ci.yml).
{deps, [{rabbit_common, "3.12.14"}]}.
