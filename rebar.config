{erl_opts, [debug_info]}.
%% rabbit_common is used only for headers (#auth_user) + the authn behaviour,
%% which are stable across RabbitMQ 3.8-4.0, so this version does not affect
%% runtime compatibility. It is a local-build default; CI overrides it to
%% compile against 3.11 / 3.12 / 3.13 / 4.0 / 4.1 (see .github/workflows/ci.yml).
{deps, [{rabbit_common, "3.12.14"}]}.
