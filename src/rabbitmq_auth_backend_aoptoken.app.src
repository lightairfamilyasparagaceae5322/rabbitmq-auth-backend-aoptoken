{application, rabbitmq_auth_backend_aoptoken, [
    {description, "Auth backend for RabbitMQ: pre-issued JWT (token:) credentials, HS/RS/ES"},
    {vsn, "0.2.3"},
    {modules, []},
    {registered, []},
    {applications, [kernel, stdlib, crypto, rabbit_common, rabbit]},
    {optional_applications, []},
    {env, [{leeway_seconds, 0}, {accept_bare_jwt, false}]},
    {broker_version_requirements, []}
]}.
