{application, rabbitmq_auth_backend_aoptoken, [
    {description, "RabbitMQ auth backend for pre-issued HS256 JWT (token:) credentials"},
    {vsn, "0.1.0"},
    {modules, []},
    {registered, []},
    {applications, [kernel, stdlib, crypto, rabbit_common]},
    {env, [{key_file, "/etc/rabbitmq/token.key"}]}
]}.
